    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
