rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /lotto_draws/{round} { allow read: if true; }
    match /meta/latest { allow read: if true; }
    match /service_stats/{round} { allow read: if true; }

    // registerUser (Admin SDK) owns registration, numbering and identity fields.
    match /users/{uid} {
      allow read: if owns(uid);
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nickname', 'lastLoginAt', 'updatedAt', 'schemaVersion',
          'fcmToken', 'fcmTokenUpdatedAt'
        ])
        && (!('nickname' in request.resource.data) ||
          (request.resource.data.nickname is string &&
           request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 20))
        && (!('lastLoginAt' in request.resource.data) || request.resource.data.lastLoginAt is timestamp)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && (!('schemaVersion' in request.resource.data) ||
          (request.resource.data.schemaVersion is int && request.resource.data.schemaVersion >= 1))
        // Legacy shared tokens may be removed, never set or changed by clients.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmToken']) ||
          !('fcmToken' in request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmTokenUpdatedAt']) ||
          !('fcmTokenUpdatedAt' in request.resource.data));

      match /devices/{deviceId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.keys().hasOnly(['token', 'enabled', 'updatedAt'])
          && request.resource.data.enabled is bool
          && ((!request.resource.data.enabled && !('token' in request.resource.data)) ||
            (request.resource.data.token is string && request.resource.data.token.size() > 0
              && request.resource.data.token.size() <= 4096))
          && request.resource.data.updatedAt == request.time;
      }

      match /{collection}/{recordId} {
        function isRecord() {
          return collection in ['number_sets', 'purchase_history'];
        }
        function validRecord() {
          return (!('deleted' in request.resource.data) || request.resource.data.deleted is bool)
            && request.resource.data.updatedAt == request.time;
        }
        allow read: if owns(uid) && isRecord();
        // Existing payloads stay compatible. Deletions are durable tombstones.
        allow create: if owns(uid) && isRecord() && validRecord()
          && exists(/databases/$(database)/documents/users/$(uid));
        allow update: if owns(uid) && isRecord() && validRecord()
          && (resource.data.get('deleted', false) != true ||
            request.resource.data.get('deleted', false) == true);
      }
    }

    // Preserve guest feedback while bounding payload size and reported identity.
    match /feedback/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
          'category', 'text', 'userNumber', 'provider', 'createdAt'
        ])
        && request.resource.data.category in ['일반 의견', '버그 신고', '기능 요청', '기타']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.userNumber is int
        && request.resource.data.createdAt == request.time
        && ((request.auth == null && request.resource.data.provider == 'guest'
            && request.resource.data.userNumber == 0)
          || (request.auth != null
            && request.resource.data.provider == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.provider
            && request.resource.data.userNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userNumber));
    }

    match /{document=**} { allow read, write: if false; }
  }
}
