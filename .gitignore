#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Cloud Functions (Node) ──────────────────────
functions/node_modules/
functions/.env
functions/*.log
firebase-debug.log
.firebase/

# ── iOS/macOS CocoaPods (재생성 가능) ───────────
ios/Pods/
macos/Pods/
ios/.symlinks/
macos/.symlinks/

# ── 서명/비밀 (혹시 프로젝트 안에 두게 될 경우 대비) ──
**/key.properties
**/*.jks
**/*.keystore
*.p12
*.mobileprovision

# ── 기타 ────────────────────────────────────────
*.apk
*.aab
*.ipa


# Local build reports and compiler caches
/android/build/
/android/.kotlin/

# Local environment files and private signing/server credentials
.env
.env.*
!.env.example
!.env.template
functions/.runtimeconfig.json
*.p8
*.pem
*.key
**/*service-account*.json
**/*serviceAccount*.json
**/*firebase-adminsdk*.json

# Private server credentials and local environment files
.envrc
.secret.local
.secret.*.local
*.pfx
**/*service_account*.json
